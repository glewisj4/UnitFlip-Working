# UnitFlip production frontend environment
# Copy to `.env.production.local` or provide these values in your shell/CI before `docker compose -f compose.prod.yml up --build -d`

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_EDGE_FUNCTIONS=true

# Legacy dev-only proxy. Do not set for production unless you intentionally restore an /api backend.
# VITE_API_PROXY_TARGET=
